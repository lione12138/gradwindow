{
  "name": "gradwindow-frontend",
  "version": "0.0.0",
  "private": true,
  "description": "Lint and format tooling for the GradWindow static frontend.",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"web/*.js\" \"tests/e2e/*.js\" \"playwright.config.mjs\"",
    "format:check": "prettier --check \"web/*.js\" \"tests/e2e/*.js\" \"playwright.config.mjs\"",
    "test:e2e": "playwright test",
    "test:e2e:build": "python -m gradwindow.cli build-site && playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@playwright/test": "^1.62.1",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.11.0",
    "prettier": "^3.3.3"
  }
}
