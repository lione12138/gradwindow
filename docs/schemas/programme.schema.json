{
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "title": "Id",
      "type": "string"
    },
    "universityId": {
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "title": "Universityid",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "degreeType": {
      "title": "Degreetype",
      "type": "string"
    },
    "faculty": {
      "default": "",
      "title": "Faculty",
      "type": "string"
    },
    "programmeGroupId": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Programmegroupid"
    },
    "applicationUrl": {
      "format": "uri",
      "minLength": 1,
      "title": "Applicationurl",
      "type": "string"
    },
    "sourceUrl": {
      "format": "uri",
      "minLength": 1,
      "title": "Sourceurl",
      "type": "string"
    },
    "inheritsWindowFrom": {
      "default": "",
      "title": "Inheritswindowfrom",
      "type": "string"
    },
    "admissionStatus": {
      "anyOf": [
        {
          "const": "paused",
          "enum": [
            "paused"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Admissionstatus"
    },
    "moratoriumFrom": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Moratoriumfrom"
    },
    "moratoriumTo": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Moratoriumto"
    }
  },
  "required": [
    "id",
    "universityId",
    "name",
    "degreeType",
    "applicationUrl",
    "sourceUrl"
  ],
  "title": "Programme",
  "type": "object"
}
